import numpy as np
import matplotlib.pyplot as pltnp.random.seed(42)
COLORS = ["#2878B5", "#E07A1F", "#2E8B57"]  # blue, orange, green
CLASSES = [0, 1, 2]def estimate_parameters(X, y, classes, covariance_type="class"):
    """Estimate each class mean and either class-specific or pooled covariance."""
    means, covs = [], []
    for c in classes:
        points = X[y == c]
        means.append(np.mean(points, axis=0))
    means = np.array(means)

    if covariance_type == "shared":
        total = np.zeros((X.shape[1], X.shape[1]))
        count = 0
        for i, c in enumerate(classes):
            points = X[y == c]
            diff = points - means[i]
            total += diff.T @ diff
            count += len(points)
        shared_cov = total / count
        covs = [shared_cov for _ in classes]
    else:
        for i, c in enumerate(classes):
            points = X[y == c]
            diff = points - means[i]
            covs.append((diff.T @ diff) / len(points))
    return means, np.array(covs)

def gaussian_log_score(X, mean, cov):
    """Log of multivariate Gaussian density; numerically safer than PDF."""
    sign, log_det = np.linalg.slogdet(cov)
    if sign <= 0:
        cov = cov + np.eye(len(mean)) * 1e-6
        sign, log_det = np.linalg.slogdet(cov)
    diff = X - mean
    inv_cov = np.linalg.inv(cov)
    distance = np.sum((diff @ inv_cov) * diff, axis=1)
    return -0.5 * (len(mean) * np.log(2 * np.pi) + log_det + distance)

def predict(X, means, covs):
    scores = np.column_stack([
        gaussian_log_score(X, means[i], covs[i])
        for i in range(len(means))
    ])
    return np.argmax(scores, axis=1), scores

def confusion_matrix(y_true, y_pred, classes):
    matrix = np.zeros((len(classes), len(classes)), dtype=int)
    for i, c1 in enumerate(classes):
        for j, c2 in enumerate(classes):
            matrix[i, j] = np.sum((y_true == c1) & (y_pred == c2))
    return matrix

def plot_roc(y_true, scores, classes, title, labels=None):
    plt.figure(figsize=(6.5, 5))
    for i, c in enumerate(classes):
        binary = (y_true == c).astype(int)
        order = np.argsort(scores[:, i])[::-1]
        sorted_y = binary[order]
        positives = np.sum(binary == 1)
        negatives = np.sum(binary == 0)
        tpr = np.r_[0, np.cumsum(sorted_y) / positives]
        fpr = np.r_[0, np.cumsum(1 - sorted_y) / negatives]
        auc = np.trapezoid(tpr, fpr)
        name = labels[i] if labels else f"Class {c}"
        plt.plot(fpr, tpr, color=COLORS[i], linewidth=2,
                 label=f"{name} (AUC={auc:.3f})")
    plt.plot([0, 1], [0, 1], "k--", linewidth=1, label="Random")
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.title(title)
    plt.xlim(0, 1); plt.ylim(0, 1.02)
    plt.grid(alpha=0.25); plt.legend(); plt.tight_layout()
    plt.savefig(title.lower().replace(" ", "_").replace(":", "").replace("/", "_") + ".png", dpi=160)
    plt.show()

def run_experiment(X, y, name, covariance_type, class_names=None, plot_roc_curve=True):
    # Stratified 80/20 split so each class keeps the same train/test ratio
    rng = np.random.default_rng(42)
    train_idx, test_idx = [], []
    for c in np.unique(y):
        idx = np.where(y == c)[0]
        rng.shuffle(idx)
        cut = int(0.8 * len(idx))
        train_idx.extend(idx[:cut]); test_idx.extend(idx[cut:])
    train_idx, test_idx = np.array(train_idx), np.array(test_idx)
    Xtr, Xte, ytr, yte = X[train_idx], X[test_idx], y[train_idx], y[test_idx]

    means, covs = estimate_parameters(Xtr, ytr, np.unique(y), covariance_type)
    pred, scores = predict(Xte, means, covs)
    cm = confusion_matrix(yte, pred, np.unique(y))
    accuracy = 100 * np.mean(pred == yte)

    # Decision regions and test points
    margin_x = 0.08 * (X[:, 0].max() - X[:, 0].min())
    margin_y = 0.08 * (X[:, 1].max() - X[:, 1].min())
    xx, yy = np.meshgrid(
        np.linspace(X[:, 0].min()-margin_x, X[:, 0].max()+margin_x, 180),
        np.linspace(X[:, 1].min()-margin_y, X[:, 1].max()+margin_y, 180))
    grid = np.c_[xx.ravel(), yy.ravel()]
    grid_pred, _ = predict(grid, means, covs)
    Z = grid_pred.reshape(xx.shape)

    plt.figure(figsize=(7, 5.5))
    plt.contourf(xx, yy, Z, levels=np.arange(-0.5, len(np.unique(y))+0.5, 1),
                 colors=COLORS[:len(np.unique(y))], alpha=0.15)
    for i, c in enumerate(np.unique(y)):
        pts = Xte[yte == c]
        label = class_names[i] if class_names else f"Class {c+1}"
        plt.scatter(pts[:, 0], pts[:, 1], s=15, alpha=0.7,
                    color=COLORS[i], label=label, edgecolors="none")
        plt.scatter(means[i, 0], means[i, 1], marker="X", s=120,
                    color=COLORS[i], edgecolors="black", linewidths=0.7)
    plt.xlabel("X"); plt.ylabel("Y")
    plt.title(f"{name}\nAccuracy = {accuracy:.2f}%")
    plt.legend(); plt.grid(alpha=0.2); plt.tight_layout()
    plt.savefig(name.lower().replace(" ", "_").replace("-", "").replace("/", "_") + "_boundary.png", dpi=160)
    plt.show()

    if plot_roc_curve:
        plot_roc(yte, scores, np.unique(y), f"ROC: {name}",
                 labels=class_names)
    print(f"\n{name}")
    print(f"Training points: {len(Xtr)} | Test points: {len(Xte)}")
    print("Estimated means:\n", np.round(means, 3))
    print("Estimated covariance matrices:\n", np.round(covs, 3))
    print(f"Accuracy: {accuracy:.2f}%")
    print("Confusion matrix (rows=actual, columns=predicted):\n", cm)
    return {"name": name, "accuracy": accuracy, "cm": cm, "means": means,
            "covs": covs, "ntrain": len(Xtr), "ntest": len(Xte)}N = 10000
base_means = [np.array([0., 0.]), np.array([5., 5.]), np.array([0., 7.])]
cases = [
    ("Isotropic - shared covariance", [np.eye(2), np.eye(2), np.eye(2)], "shared"),
    ("Diagonal - shared covariance", [np.diag([2., 5.])]*3, "shared"),
    ("Full - shared covariance", [np.array([[3., 1.2], [1.2, 2.]])]*3, "shared"),
    ("Isotropic - different covariance", [np.eye(2), 2*np.eye(2), 3*np.eye(2)], "class"),
    ("Diagonal - different covariance", [np.diag([1., 3.]), np.diag([2., 5.]), np.diag([4., 2.])], "class"),
    ("Full - different covariance", [np.array([[2., .8], [.8, 3.]]),
                                     np.array([[3., -1.], [-1., 2.]]),
                                     np.array([[2., .5], [.5, 4.]])], "class")
]
synthetic_results = []
for name, covs, mode in cases:
    parts = [np.random.multivariate_normal(base_means[i], covs[i], N)
             for i in range(3)]
    X = np.vstack(parts)
    y = np.repeat(CLASSES, N)
    result = run_experiment(X, y, name, mode, plot_roc_curve=True)
    synthetic_results.append(result)

print("\nSYNTHETIC SUMMARY")
for r in synthetic_results:
    print(f"{r['name']}: {r['accuracy']:.2f}%")
